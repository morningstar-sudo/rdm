{
  "manifest_version": 3,
  "name": "RDM - Download with RDM",
  "version": "0.3.0",
  "description": "Send browser downloads and user-selected links to RDM.",
  "key": "",
  "permissions": ["activeTab", "contextMenus", "downloads", "nativeMessaging"],
  "action": {
    "default_title": "Send link to RDM",
    "default_popup": "popup.html"
  },
  "commands": {
    "download-current-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Download the current page with RDM"
    }
  },
  "background": {
    "service_worker": "service_worker.js"
  }
}
